---
interface Props {
  eyebrow: string;
  items: { question: string; answer: string }[];
}

const { eyebrow, items } = Astro.props;
---

<section class="section faq-section" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div><p class="eyebrow">{eyebrow}</p><h2 id="faq-title">As suas dúvidas,<br />esclarecidas.</h2></div>
    <div class="faq-list">
      {items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </div>
  </div>
</section>
