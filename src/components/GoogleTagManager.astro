---
// Vai no <head>, o mais acima possível.
// O consentimento é definido ANTES de o GTM carregar: por defeito tudo recusado,
// e só fica "granted" se o visitante já aceitou no banner (CookieConsent.astro).
import { analytics } from '../data/analytics';

const { gtmId, consentKey, consentMaxAgeMs } = analytics;
---

<script is:inline define:vars={{ gtmId, consentKey, consentMaxAgeMs }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };

  var analyticsConsent = 'denied';
  try {
    var saved = JSON.parse(localStorage.getItem(consentKey) || 'null');
    if (saved && saved.value === 'granted' && Date.now() - saved.time < consentMaxAgeMs) analyticsConsent = 'granted';
  } catch (e) {}

  window.gtag('consent', 'default', {
    analytics_storage: analyticsConsent,
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
  });

  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', gtmId);
</script>
