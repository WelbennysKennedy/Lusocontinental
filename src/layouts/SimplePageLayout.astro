---
import { routes } from '../data/site';
import { footerAreas } from '../data/zonas';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style is:inline>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#fafafa;color:#171717;font-family:system-ui,-apple-system,"Segoe UI",sans-serif}main{width:100%;max-width:540px;padding:36px;border:1px solid #e3e3e3;border-radius:18px;background:#fff;box-shadow:0 2px 3px #00000004}h1{font-size:28px;line-height:1.2;letter-spacing:-.04em}p{color:#606060;line-height:1.7}p a{color:#262626}.check{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#e9f6ee;color:#28754a;font-size:25px}.links{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.links a{padding:12px 16px;border:1px solid #dedede;border-radius:8px;color:#262626;font-size:14px;text-decoration:none}.links a:first-child{background:#171717;color:#fff;border-color:#171717}a:focus-visible{outline:2px solid #555;outline-offset:3px}footer{margin-top:24px;padding-top:18px;border-top:1px solid #e3e3e3}footer p{margin:0;font-size:13px}@media(max-width:480px){main{padding:26px}h1{font-size:25px}}
    </style>
  </head>
  <body>
    <main>
      <slot />
      <div class="links"><a href={routes.home}>Voltar ao início</a><a href={routes.plataforma}>Plataforma elevatória</a><a href={routes.transportes}>Transportes</a></div>
      <footer><p>{footerAreas}</p></footer>
    </main>
  </body>
</html>
